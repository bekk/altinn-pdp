# Copy to .env and fill in the values. .env is gitignored. When you add or change a variable here, update the table in
# README.md too.
#
# Nothing reads this file directly. scripts/dev.sh exports it, and the server then resolves the variables through
# the $ENV_VAR references in altinn-pdp-rest-server/src/main/resources/application.yaml (or the file in
# APPLICATION_CONFIG_FILE). Starting the server any other way - an IDE run configuration, a bare ./gradlew run -
# means putting these in the environment yourself.

# Client id from Maskinporten (Digdir self-service, or a Digdirator secret).
MASKINPORTEN_CLIENT_ID=

# Private key as JWK, on a single line. scripts/dev.sh loads this file by sourcing it as a
# shell script, so wrap the JSON in single quotes - otherwise the double quotes get stripped
# and the JWK fails to parse.
# Example: MASKINPORTEN_CLIENT_JWK='{"p":"...","kty":"RSA","q":"...","d":"...","e":"AQAB","kid":"my-key","n":"..."}'
MASKINPORTEN_CLIENT_JWK=

# Which Altinn to talk to: TT02 or PROD.
ALTINN_ENVIRONMENT=

# Azure API Management subscription key for the PDP /authorize endpoint (Access Management
# products). Ordered from Altinn servicedesk. Sent as the Ocp-Apim-Subscription-Key header.
ALTINN_SUBSCRIPTION_KEY=

# Optional - the values below are the defaults.

# Port the server listens on.
PORT=8080

# Access logging: one log line per HTTP request. true or false.
ACCESS_LOG_ENABLED=true

# Cache PDP decisions, so repeated lookups do not go to Altinn. true or false. A cached decision is
# kept until it expires, even if access changes in Altinn in the meantime: revoked access is still
# permitted, and granted access is still denied.
DECISION_CACHE_ENABLED=false

# Where the cache keeps decisions: IN_MEMORY (each pod has its own, lost on restart) or REDIS
# (shared by every pod). REDIS needs DECISION_CACHE_REDIS_URL and DECISION_CACHE_REDIS_KEY_SECRET.
DECISION_CACHE_TYPE=IN_MEMORY

# How long a cached decision is kept, in seconds. No caller gets an older decision, whatever
# Cache-Control max-age it sends.
DECISION_CACHE_TIME_TO_LIVE_SECONDS=60

# How old a cached decision may be, in seconds, for a caller that sends no Cache-Control max-age.
# 0 sends those calls to Altinn every time. Capped to DECISION_CACHE_TIME_TO_LIVE_SECONDS.
DECISION_CACHE_DEFAULT_MAX_AGE_SECONDS=0

# Only with DECISION_CACHE_TYPE=IN_MEMORY. How many decisions the cache holds before it evicts the
# least used.
DECISION_CACHE_MAXIMUM_SIZE=10000

# Only with DECISION_CACHE_TYPE=REDIS. The Redis (or Valkey) to use, such as redis://localhost:6379
# for the one in compose.yaml.
DECISION_CACHE_REDIS_URL=

# Only with DECISION_CACHE_TYPE=REDIS. The secret the server hashes each question with (HMAC-SHA256)
# before it goes to Redis, so Redis never sees a national identity number. Every pod needs the same
# one, and it must be at least 32 bytes. Make one with: openssl rand -base64 32
DECISION_CACHE_REDIS_KEY_SECRET=

# Only with DECISION_CACHE_TYPE=REDIS. How long to wait for Redis, in milliseconds, before treating it
# as unavailable.
DECISION_CACHE_REDIS_TIMEOUT_MILLIS=100

# Only with DECISION_CACHE_TYPE=REDIS. What to do when Redis cannot be read: BYPASS asks Altinn without
# the cache, which costs a billed lookup per call; REJECT refuses the call with 503 and the problem
# type tag:kartverket.no,2026:decision-cache-unavailable. A call with max-age=0 never reads the cache,
# so it is asked of Altinn in both modes.
DECISION_CACHE_REDIS_FAILURE_MODE=BYPASS

# Path to a logback.xml that replaces the bundled one.
LOGBACK_CONFIG_FILE=

# Path to an application.yaml that replaces the bundled one. The other variables here are only read if that file
# refers to them.
APPLICATION_CONFIG_FILE=
