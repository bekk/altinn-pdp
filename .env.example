# Copy to .env and fill in the values. .env is gitignored.
#
# Read by altinn-pdp-rest-server to build the PdpClient used by POST /authorize. A real
# environment variable always takes precedence over the same name in .env, so this file only
# matters for local development.

# Client id from Maskinporten (Digdir self-service, or a Digdirator secret).
MASKINPORTEN_CLIENT_ID=

# Private key as JWK, on a single line. scripts/dev.sh loads this file by sourcing it as a
# shell script, so wrap the JSON in single quotes - otherwise the double quotes get stripped
# and the JWK fails to parse.
# Example: MASKINPORTEN_CLIENT_JWK='{"p":"...","kty":"RSA","q":"...","d":"...","e":"AQAB","kid":"my-key","n":"..."}'
MASKINPORTEN_CLIENT_JWK=

# Azure API Management subscription key for the PDP /authorize endpoint (Access Management
# products). Ordered from Altinn servicedesk. Sent as the Ocp-Apim-Subscription-Key header.
ALTINN_SUBSCRIPTION_KEY=

# Optional - the values below are the defaults.

# TT02 or PROD.
ALTINN_ENVIRONMENT=TT02

MASKINPORTEN_TOKEN_URL=https://test.maskinporten.no/token

# Timeouts towards Maskinporten and Altinn, in milliseconds. This server is one hop in a longer
# chain, so these must stay below what its own callers allow - otherwise they give up before we
# can answer, and we keep working on a request nobody is waiting for. Raise them only together
# with the response budget documented in the README.
ALTINN_CONNECT_TIMEOUT_MS=2000
ALTINN_REQUEST_TIMEOUT_MS=4000
ALTINN_TOTAL_TIMEOUT_MS=8000
