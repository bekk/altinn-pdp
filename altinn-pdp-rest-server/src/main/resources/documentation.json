{
  "openapi": "3.0.3",
  "info": {
    "title": "Altinn PDP REST API",
    "description": "Simplified JSON REST API for the Altinn PDP",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "description": "Returns 200 OK if the server is up. Not part of the stable API.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/authorize": {
      "post": {
        "summary": "Check whether a systembruker is authorized",
        "description": "Asks the Altinn PDP whether the systembruker identified by [systemuserId] has been delegated [action] on [resourceId] for the party identified by [organizationNumber]. The Altinn subscription key and Maskinporten token are configured server-side; the caller never supplies them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequest"
              },
              "examples": {
                "Example#1": {
                  "value": {
                    "systemuserId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "resourceId": "altinn_access_management",
                    "organizationNumber": "923609016",
                    "action": "read"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The PDP's decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponse"
                },
                "examples": {
                  "Permit": {
                    "value": {
                      "permit": true,
                      "decision": "PERMIT",
                      "status": "urn:oasis:names:tc:xacml:1.0:status:ok",
                      "minimumAuthenticationLevel": 3,
                      "minimumAuthenticationLevelOrg": 3
                    }
                  },
                  "Deny": {
                    "value": {
                      "permit": false,
                      "decision": "DENY",
                      "status": "urn:oasis:names:tc:xacml:1.0:status:ok"
                    }
                  },
                  "NotEvaluated": {
                    "value": {
                      "permit": false,
                      "decision": "INDETERMINATE",
                      "status": "urn:oasis:names:tc:xacml:1.0:status:processing-error"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request could not be understood. Validation failures carry code VALIDATION_ERROR and list every failing field in \"errors\". A body that is not valid JSON, or has a field of the wrong type, carries MALFORMED_BODY. Note that an unknown resourceId is not a 400: Altinn answers 200 with decision INDETERMINATE and a processing-error status, which this API passes through in the \"status\" field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingFields": {
                    "value": {
                      "error": "Validation failed",
                      "code": "VALIDATION_ERROR",
                      "errors": [
                        {
                          "field": "systemuserId",
                          "code": "MISSING",
                          "message": "systemuserId is required"
                        },
                        {
                          "field": "resourceId",
                          "code": "MISSING",
                          "message": "resourceId is required"
                        }
                      ]
                    }
                  },
                  "InvalidOrganizationNumber": {
                    "value": {
                      "error": "Validation failed",
                      "code": "VALIDATION_ERROR",
                      "errors": [
                        {
                          "field": "organizationNumber",
                          "code": "INVALID_FORMAT",
                          "message": "organizationNumber must have a valid MOD11 check digit"
                        }
                      ]
                    }
                  },
                  "MalformedBody": {
                    "value": {
                      "error": "Malformed request body",
                      "code": "MALFORMED_BODY"
                    }
                  },
                  "AltinnRejected": {
                    "value": {
                      "error": "Altinn rejected the request",
                      "code": "UPSTREAM_REJECTED"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "The call to Altinn or Maskinporten failed for a reason unrelated to this request's content - the PDP itself errored, or a token could not be obtained. The response never includes Altinn's own error details; those are logged server-side instead.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Example#1": {
                    "value": {
                      "error": "The call to Altinn failed",
                      "code": "UPSTREAM_ERROR"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unanticipated server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Example#1": {
                    "value": {
                      "error": "Internal server error",
                      "code": "INTERNAL_ERROR"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizeRequest": {
        "type": "object",
        "required": [
          "systemuserId",
          "resourceId",
          "organizationNumber",
          "action"
        ],
        "properties": {
          "systemuserId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "The systembruker id from the token's authorization_details. Always a UUID."
          },
          "resourceId": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{4,}$",
            "description": "The resource's identifier in the Altinn Resource Registry. Lowercase letters, digits, underscore and hyphen, at least 4 characters - the Resource Registry's own rule."
          },
          "organizationNumber": {
            "type": "string",
            "pattern": "^[0-9]{9}$",
            "description": "The plain Norwegian org number (exactly 9 digits, with a valid MOD11 check digit) of the party whose access is being checked - the customer/business systemuserId is acting on behalf of, e.g. \"923609016\". Not the caller's own org number, and not the ISO6523-prefixed form Maskinporten tokens use."
          },
          "action": {
            "type": "string",
            "description": "e.g. \"read\" or \"write\"."
          }
        }
      },
      "AuthorizeResponse": {
        "type": "object",
        "required": [
          "permit",
          "decision"
        ],
        "properties": {
          "permit": {
            "type": "boolean",
            "description": "Whether the request is permitted - shorthand for decision == \"PERMIT\"."
          },
          "decision": {
            "type": "string",
            "description": "The underlying XACML decision.",
            "enum": [
              "PERMIT",
              "DENY",
              "NOT_APPLICABLE",
              "INDETERMINATE"
            ]
          },
          "status": {
            "type": "string",
            "nullable": true,
            "description": "Altinn's XACML status URN. \"...:status:ok\" means the request was evaluated; \"...:status:processing-error\" means it could not be, which is how an unknown resourceId shows up. Omitted when Altinn sends no status."
          },
          "minimumAuthenticationLevel": {
            "type": "integer",
            "nullable": true,
            "description": "From the urn:altinn:minimum-authenticationlevel obligation. When present on a PERMIT, the decision is conditional: the caller must confirm its own end user met at least this authentication level before acting on the permit. This API cannot check it, as it never sees the caller's token. Omitted when Altinn attaches no such obligation."
          },
          "minimumAuthenticationLevelOrg": {
            "type": "integer",
            "nullable": true,
            "description": "As minimumAuthenticationLevel, but from the urn:altinn:minimum-authenticationlevel-org obligation."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable summary. Not stable - branch on `code`, not on this."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code.",
            "enum": [
              "VALIDATION_ERROR",
              "MALFORMED_BODY",
              "UPSTREAM_REJECTED",
              "UPSTREAM_ERROR",
              "INTERNAL_ERROR"
            ]
          },
          "errors": {
            "type": "array",
            "description": "Present when code is VALIDATION_ERROR. Every field that failed, not just the first.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "The request field that failed."
          },
          "code": {
            "type": "string",
            "enum": [
              "MISSING",
              "INVALID_FORMAT"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
